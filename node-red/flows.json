  {
    "id": "f_ext",
    "type": "function",
    "z": "tab_airguard",
    "name": "Guardar contexto externo",
    "func": "// R5: guarda o contexto externo; em caso de erro mantem o ultimo valor\nif (msg.statusCode !== 200 || !msg.payload || !msg.payload.main) {\n    node.warn('OpenWeather: falha (HTTP ' + msg.statusCode + '), mantendo ultimo valor'); return null;\n}\nconst p = msg.payload;\nconst ext = { temperatura: p.main.temp, umidade: p.main.humidity, descricao: (p.weather && p.weather[0]) ? p.weather[0].description : '' };\nflow.set('ext', ext);\nmsg.payload = ext;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
