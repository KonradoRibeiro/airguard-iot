  {
    "id": "f_url",
    "type": "function",
    "z": "tab_airguard",
    "name": "Montar URL OpenWeather",
    "func": "const key = env.get('OPENWEATHER_KEY');\nconst cidade = env.get('CIDADE') || 'Sao Paulo,BR';\nif (!key || key.startsWith('COLE')) { node.warn('OPENWEATHER_KEY nao configurada (aba AirGuard IoT > Propriedades > Variaveis de ambiente)'); return null; }\nmsg.url = 'https://api.openweathermap.org/data/2.5/weather?q=' + encodeURIComponent(cidade) + '&appid=' + key + '&units=metric&lang=pt_br';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
