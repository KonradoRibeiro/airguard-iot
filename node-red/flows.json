  {
    "id": "f_r12",
    "type": "function",
    "z": "tab_airguard",
    "name": "R1 validar + R2 CO2",
    "func": "// R1: validacao  |  R2: CO2 estimado a partir do valor bruto do sensor de gas (0-4095)\nconst p = msg.payload;\nif (typeof p !== 'object' || p === null) { node.warn('R1: payload invalido'); return null; }\nconst { temperatura, umidade, gas } = p;\nconst ok = [temperatura, umidade, gas].every(v => typeof v === 'number' && isFinite(v));\nif (!ok) { node.warn('R1: campos ausentes ou nao numericos'); return null; }\nif (gas < 0 || gas > 4095 || temperatura < -40 || temperatura > 80 || umidade < 0 || umidade > 100) {\n    node.warn('R1: leitura fora da faixa, descartada'); return null;\n}\nconst co2 = Math.round(400 + (gas / 4095) * 1600);   // ppm (400 a 2000)\nmsg.payload = { temperatura, umidade, gas, co2 };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 100,
    "wires": [
      [
        "f_r345"
      ]
    ]
  },
  {
    "id": "f_r345",
    "type": "function",
    "z": "tab_airguard",
    "name": "R3 classe + R4 exaustor + R5 contexto",
    "func": "// R3: classificacao | R4: exaustor com histerese | R5: contexto externo\nconst LEITURAS_RUIM = 3;   // leituras consecutivas 'Ruim' para ligar\nconst LIMITE_OFF    = 800; // ppm abaixo do qual desliga (histerese)\nconst d = msg.payload;\nconst classe = d.co2 < 700 ? 'Boa' : (d.co2 <= 1000 ? 'Moderada' : 'Ruim');\n\nlet ruins = flow.get('ruins') || 0;\nruins = (classe === 'Ruim') ? ruins + 1 : 0;\nflow.set('ruins', ruins);\n\nconst atual = flow.get('exaustor') || 'OFF';\nlet novo = atual;\nif (atual === 'OFF' && ruins >= LEITURAS_RUIM) novo = 'ON';\nelse if (atual === 'ON' && d.co2 < LIMITE_OFF) novo = 'OFF';\n\nconst ext = flow.get('ext') || null;\nlet recomendacao = '';\nif (classe === 'Ruim') {\n    if (ext && ext.temperatura >= 18 && ext.temperatura <= 28)\n        recomendacao = 'Ar interno ruim e externo ameno (' + ext.temperatura + ' C): ventilacao natural viavel';\n    else\n        recomendacao = 'Ar interno ruim: acionar exaustor';\n}\nd.classe = classe; d.leituras_ruim = ruins; d.exaustor = novo; d.externo = ext; d.recomendacao = recomendacao;\n\nconst saida1 = { payload: d };\nlet saida2 = null;\nif (novo !== atual) {\n    flow.set('exaustor', novo);\n    saida2 = { topic: 'airguard-upm/d2/comando', payload: novo, co2: d.co2 };\n}\nreturn [saida1, saida2];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 650,
    "y": 100,
    "wires": [
      [
        "d_proc",
        "f_i_med"
      ],
      [
        "out_cmd",
        "d_cmd",
        "f_i_evt"
      ]
    ]
  },
